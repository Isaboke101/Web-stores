# ============================================================
# INJILI APPAREL — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to git — only commit this example file.
# For production: copy .env to the server and update values.
# No code changes required — only this file.
# ============================================================

# ── Database ──────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=injili_db
DB_USER=root
DB_PASS=

# ── Application ───────────────────────────────────────────
APP_URL=http://localhost/injili
APP_ENV=sandbox

# ── M-Pesa Daraja (Safaricom) ─────────────────────────────
# Sandbox: use shortcode 174379, testable at developer.safaricom.co.ke
# Live: replace with your Till Number (Buy Goods) or Paybill shortcode
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
# Callback URL must be publicly reachable (use ngrok for local dev)
# e.g. https://abc123.ngrok-free.app/injili/api/payment/mpesa_callback.php
MPESA_CALLBACK_URL=

# ── Email (PHPMailer via Gmail SMTP) ──────────────────────
# Use a Gmail App Password (not your main password).
# Enable 2FA on Gmail first, then generate App Password at
# myaccount.google.com/apppasswords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Injili Apparel

# ── Admin notification recipients ─────────────────────────
ADMIN_EMAIL=
ADMIN_PHONE=

# ── Africa's Talking (SMS) ────────────────────────────────
# Sign up at africastalking.com — sandbox is free for testing
AT_API_KEY=
AT_USERNAME=sandbox
AT_SENDER_ID=INJILI

# ── WhatsApp (CallMeBot) ──────────────────────────────────
# Free service: send "I allow callmebot to send messages to my phone"
# to +34 644 39 84 06 on WhatsApp to get your API key
CALLMEBOT_PHONE=
CALLMEBOT_API_KEY=

# ── Pickup Mtaani ─────────────────────────────────────────
# Set PM_USE_MOCK=true during prototype. When you have a real
# API key from Pickup Mtaani, set to false and fill in below.
# Note: PM API requires a registered business account with PM.
PM_USE_MOCK=true
PM_BASE_URL=https://api.pickupmtaani.com/v1
PM_API_KEY=
PM_SENDER_NAME=Injili Apparel
